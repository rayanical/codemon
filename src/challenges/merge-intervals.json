{
  "id": "merge-intervals",
  "title": "Merge Intervals",
  "difficulty": "Medium",
  "topics": ["Arrays", "Sorting"],
  "functionName": "merge_intervals",
  "description": "Given a list of intervals [`start`, `end`], merge all overlapping intervals. Return the non-overlapping intervals sorted by their `start` value.\n\nIntervals that touch at an endpoint count as overlapping. Do not assume the input is sorted.",
  "constraints": ["0 ≤ len(intervals) ≤ 10,000", "−10⁶ ≤ start ≤ end ≤ 10⁶"],
  "starterCode": "def merge_intervals(intervals):\n    # Return the merged intervals, sorted by start.\n    pass\n",
  "tests": [
    {
      "id": "overlap",
      "name": "Overlapping intervals",
      "args": [
        [
          [1, 3],
          [2, 6],
          [8, 10],
          [15, 18]
        ]
      ],
      "expected": [
        [1, 6],
        [8, 10],
        [15, 18]
      ],
      "hidden": false
    },
    {
      "id": "touch",
      "name": "Touching endpoints",
      "args": [
        [
          [1, 4],
          [4, 5]
        ]
      ],
      "expected": [[1, 5]],
      "hidden": false
    },
    {
      "id": "unsorted",
      "name": "Unsorted input",
      "args": [
        [
          [8, 10],
          [1, 3],
          [2, 6]
        ]
      ],
      "expected": [
        [1, 6],
        [8, 10]
      ],
      "hidden": true
    },
    {
      "id": "empty",
      "name": "Empty list",
      "args": [[]],
      "expected": [],
      "hidden": true
    },
    {
      "id": "nested",
      "name": "Contained interval",
      "args": [
        [
          [1, 10],
          [2, 3]
        ]
      ],
      "expected": [[1, 10]],
      "hidden": true
    }
  ]
}
